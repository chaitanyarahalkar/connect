# Postgres (docker-compose defaults)
DATABASE_URL=postgres://connect:connect@localhost:5432/connect

# Redis (docker-compose defaults)
REDIS_URL=redis://localhost:6379

# Master key for envelope encryption (KEK). Generate with: openssl rand -base64 32
CONNECT_MASTER_KEY=

# Key provider: env (default), aws-kms, or gcp-kms.
# - env: CONNECT_MASTER_KEY is version v1. To rotate, add new versions via
#   CONNECT_MASTER_KEYS={"v2":"<base64>"} + CONNECT_MASTER_KEY_VERSION=v2, then
#   run: pnpm --filter @connect/api rotate-key
# - aws-kms: set CONNECT_KMS_KEY_ID to a KMS key ARN; credentials come from
#   AWS_REGION + AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY[/AWS_SESSION_TOKEN].
# - gcp-kms: set CONNECT_KMS_KEY_ID to the cryptoKey resource name; credentials
#   from GOOGLE_APPLICATION_CREDENTIALS (path) or GCP_SERVICE_ACCOUNT_JSON (inline).
# CONNECT_KEY_PROVIDER=env
# CONNECT_KMS_KEY_ID=

# Secret for better-auth session signing. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Issuer URL for workload OIDC tokens (the API's own public URL)
CONNECT_ISSUER=http://localhost:4000

API_PORT=4000
DASHBOARD_URL=http://localhost:3000
MOCK_PROVIDER_URL=http://localhost:4100

# Used by the SDK / demo script
CONNECT_API_URL=http://localhost:4000
